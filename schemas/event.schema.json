{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "required": ["id", "label"],
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "severity": { "type": "string" },
    "weight": { "type": "number" },
    "cooldownMinutes": { "type": "number" }
  },
  "additionalProperties": true
}
